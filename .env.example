# Copy to .env and fill in (the .env file is NEVER committed).

# --- Required (GitHub: Secrets) ---
YOUTUBE_API_KEY=
GRAPH_API_ACCESS_TOKEN=
GRAPH_API_ACCOUNT_ID=

# --- Required (GitHub: Variables) ---
# Your channel: UC… channel ID, @handle or channel URL
YOUTUBE_CHANNEL_ID=

# --- Optional (GitHub: Variables), values shown are the defaults ---
# IANA timezone, e.g. Europe/Prague, America/New_York
TIMEZONE=UTC
PUBLISH_TIME=17:00
COMMENT_DELAY_SECONDS=60
# Comment under the Reel: youtube (copy your comment from the Short) | template | off
COMMENT_MODE=youtube
# {full_video_url} = first YouTube link in the Short description (else your channel); \n = new line
COMMENT_TEMPLATE=▶️ Full video on YouTube: {full_video_url}\n🔗 Link in bio
# graph.facebook.com = Instagram API with Facebook Login (token EAA…)
# graph.instagram.com = Instagram API with Instagram Login (token IG…)
GRAPH_API_HOST=graph.facebook.com
GRAPH_API_VERSION=v24.0
# resumable (recommended) | litterbox | s3
MEDIA_HOST=resumable
# grid = YouTube thumbnail fitted to the profile grid | youtube = thumbnail as is | none = a frame
COVER_MODE=grid
# Instagram "AI info" label by default: on | off
AI_LABEL=off

# Path to cookies.txt for yt-dlp, if YouTube blocks downloads
YTDLP_COOKIES_FILE=
# Optional paid residential proxy for YouTube downloads (not needed if you attach video files)
YTDLP_PROXY=

# Only for MEDIA_HOST=s3 (Cloudflare R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
